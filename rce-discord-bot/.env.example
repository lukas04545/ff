# ===================================================================
#  Rust Console Edition Discord bot – configuration
#  Copy this file to ".env" and fill in your values.
#  NEVER share the .env file or upload it to Git!
# ===================================================================

# ---------- Discord ----------
# Bot token from the Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# ID of your Discord server (right-click the server -> "Copy Server ID").
# With a guild ID the slash commands show up immediately.
GUILD_ID=

# ---------- RCON (G-Portal) ----------
# Server IP address (without port), e.g. 123.45.67.89
RCON_HOST=
# RCON port (G-Portal panel -> network/ports or server info "RCON port")
RCON_PORT=
# RCON password (G-Portal panel -> Settings -> Basic settings)
# Tip: use only letters and digits (no / ? # %)
RCON_PASSWORD=

# ---------- Permissions ----------
# Comma-separated role IDs that may use admin commands
ADMIN_ROLE_IDS=
# Comma-separated user IDs with admin rights (in addition to the roles)
ADMIN_USER_IDS=
# Allow /rcon (any console command)? true/false
ALLOW_RAW_RCON=true

# ---------- Channels (leave empty = feature off) ----------
# A status embed is posted here and kept up to date
STATUS_CHANNEL_ID=
# Chat bridge (in-game quick chat <-> Discord)
CHAT_CHANNEL_ID=
# Killfeed
KILLFEED_CHANNEL_ID=
# Joins/leaves, server events (heli, cargo, airdrop ...), teams
EVENTS_CHANNEL_ID=
# Bans, role changes, kits/items, bot admin actions, connection status
ADMIN_LOG_CHANNEL_ID=
# Full server console (lots of messages – use its own private channel!)
CONSOLE_LOG_CHANNEL_ID=

# ---------- Behaviour ----------
# Refresh the status embed/bot activity every X seconds (min. 30)
STATUS_INTERVAL=60
# Query the player list every X seconds (min. 10) – determines the join/leave delay
PLAYERLIST_INTERVAL=30
# Send Discord messages from the chat channel to the game (needs Message Content Intent)
CHAT_BRIDGE_TO_GAME=true
# Also show [CHAT SERVER] lines (e.g. "say") in Discord (careful: echoes the bridge)
CHAT_SHOW_SERVER_MESSAGES=false
# Show respawns ("has entered the game") in the events channel
SHOW_RESPAWNS=false
# Prefix for Discord messages in the game (Rust rich text allowed)
SAY_PREFIX=<color=#5865F2>[Discord]</color>
# Optional display name for the status embed (otherwise the server's hostname)
SERVER_DISPLAY_NAME=

# ---------- Command templates (ASSUMPTION, see README) ----------
# {name} is replaced with the player name.
KICK_COMMAND_TEMPLATE=kick "{name}"
BAN_COMMAND_TEMPLATE=banid "{name}"
UNBAN_COMMAND_TEMPLATE=unbanid "{name}"

# ---------- Kit manager ----------
# Command templates (ASSUMPTION, see README). Placeholders: {kit} {name} {group}
# {item} {amount} {condition} {container} {id}
KIT_GIVE_TEMPLATE=kit givetoplayer "{kit}" "{name}"
KIT_GIVE_GROUP_TEMPLATE=kit givetogroup "{kit}" "{group}"
KIT_GIVE_ALL_TEMPLATE=kit giveall "{kit}"
KIT_ADD_TEMPLATE=kit add "{kit}" "{item}" "{amount}" "{condition}" "{container}"
KIT_REMOVE_TEMPLATE=kit remove "{kit}" "{id}"
# Item giving for custom kits (ASSUMPTION, syntax as on Rust PC). Placeholders: {name} {item} {amount}
ITEM_GIVE_TEMPLATE=inventory.giveto "{name}" "{item}" {amount}
# Seconds to wait between respawn and giving the autokit
AUTOKIT_DELAY=3
# For quick-chat autokits, report in-game via "say": received / cooldown / limit
KIT_CLAIM_ANNOUNCE=true
# /customkit link: also make players prove ownership with two quick chat phrases in-game (default: dropdown only)
LINK_VERIFY_QUICKCHAT=false

# ---------- Support tickets with AI (DeepSeek platform) ----------
# Category in which ticket channels are created (empty = tickets off)
TICKET_CATEGORY_ID=
# Channel for ticket logs and transcripts (private!)
TICKET_LOG_CHANNEL_ID=
# Roles that see tickets and get pinged (empty = ADMIN_ROLE_IDS)
SUPPORT_ROLE_IDS=
# API key from https://platform.deepseek.com/api_keys (empty = tickets without AI, straight to staff)
# Usage & balance: https://platform.deepseek.com/usage
DEEPSEEK_API_KEY=
# Model (deepseek-chat was retired in July 2026; for current names see api-docs.deepseek.com)
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Knowledge base the AI answers from (changes apply immediately)
SUPPORT_KNOWLEDGE_FILE=support_knowledge.md
# Max. AI replies per ticket, after that staff is called
TICKET_AI_MAX_REPLIES=20
# AI may look up and claim the ticket owner's custom kits (same rules as /customkit claim)
TICKET_AI_KIT_TOOLS=true
# Roles that approve bought kits in tickets (pinged, only they + bot admins can press Approve). Empty = support roles
KIT_APPROVER_ROLE_IDS=

# ---------- Community (welcome, auto role, Discord log, rules, giveaways) ----------
# Note: welcome/auto role/join-leave log need the "Server Members Intent" in the
# Developer Portal, the message log needs the "Message Content Intent".
# Channel for welcome messages (empty = off)
WELCOME_CHANNEL_ID=
# Placeholders: {member} = mention, {server} = server name, {count} = member count,
# {rules} = " in #rules-channel" (if RULES_CHANNEL_ID is set)
WELCOME_MESSAGE=Welcome {member} to **{server}**! Please read the rules{rules} – have fun!
# Role new members get automatically (the bot role must be above it)
AUTO_ROLE_ID=
# Discord log: joins/leaves, deleted/edited messages, /mod actions, giveaways
DISCORD_LOG_CHANNEL_ID=
# Rules channel (linked in /rust and in the welcome message)
RULES_CHANNEL_ID=
# File with the rules for /rules (one rule per line)
RULES_FILE=rules.md
# Info for /rust
RUST_SERVER_PLATFORM=Rust Console Edition (Xbox & PlayStation)
RUST_SERVER_WIPE=See the announcements on Discord
# Role for giveaway winners (empty = none)
GIVEAWAY_WINNER_ROLE_ID=
# Channel where another bot (Helios, Kryvon …) announces giveaway winners – the ticket AI redeems lifetime kit prizes
GIVEAWAY_WIN_CHANNEL_ID=1558525305004757032
# When a /giveaway ends, open a prize ticket for every winner: the ticket AI redeems lifetime kit prizes
# (gives the kit's role) or calls staff. Needs tickets (TICKET_CATEGORY_ID); true/false
GIVEAWAY_AUTO_TICKET=true

# Kit prize that is neither lifetime nor names a duration (e.g. "Vip Standard"): the ticket AI gives the
# kit role for this many days. 0 = staff decides. ("VIP 7 days" always uses its own duration.)
GIVEAWAY_PRIZE_DAYS=0

# ---------- Points & shop ----------
# Members with a linked player (/customkit link) earn points and spend them in /shop
# (shop items: web interface → 🪙 Shop). true/false
ECONOMY_ENABLED=true
# Name shown for the points (e.g. coins, scrap)
POINTS_NAME=points
POINTS_PER_HOUR=10
# Per PvP kill (same killer/victim pair at most once every 10 minutes)
POINTS_PER_KILL=5
DAILY_POINTS=50
# Extra per consecutive /daily day (max. 7 days)
DAILY_STREAK_BONUS=10
# Every N hours online: custom kit and/or points (0 = off)
PLAYTIME_REWARD_HOURS=0
PLAYTIME_REWARD_KIT=
PLAYTIME_REWARD_POINTS=0

# ---------- Wipe ----------
# Set the next wipe with /wipe set or in the web interface (Community). Time zone of that time:
WIPE_TIMEZONE=Europe/Berlin
# Countdown posts (24 h, 1 h before, "wiped") – empty = events channel; role to ping (optional)
WIPE_ANNOUNCE_CHANNEL_ID=
WIPE_PING_ROLE_ID=
# What starts fresh at the wipe (a backup is made first)
WIPE_RESET_KITS=true
WIPE_RESET_STATS=false
WIPE_RESET_POINTS=false

# ---------- Reports ----------
# /report and watchlist alerts (empty = alert channel / admin log). Support roles are pinged.
REPORT_CHANNEL_ID=
# Watchlist alerts ("watched player joined") – empty = the report channel
WATCHLIST_CHANNEL_ID=

# ---------- Admin abuse protection ----------
# Someone who is not allowed spawns rockets/C4 -> remove their admin, kill them in-game, ping staff.
# Only active once ABUSE_EXEMPT_ROLE_IDS or ABUSE_EXEMPT_PLAYERS is set (so the owner is never hit).
ABUSE_PROTECTION=true
# Discord roles that may spawn (owner, co-owner) – via their linked player (/customkit link)
ABUSE_EXEMPT_ROLE_IDS=
# In-game names that may spawn, comma-separated (e.g. the owner's gamertag)
ABUSE_EXEMPT_PLAYERS=
# Words matched in the spawned item's name (rocket launchers don't count)
ABUSE_ITEMS=rocket,c4,timed explosive,explosive.timed
# Commands run on the player ({name}); several separated by ;
ABUSE_REMOVE_ADMIN_COMMANDS=removeowner "{name}";removemoderator "{name}"
# Right before the kill (god mode off), the kill itself
ABUSE_BEFORE_KILL_COMMANDS=global.god 0 "{name}"
ABUSE_KILL_COMMAND=global.killplayer "{name}"
# Run automatically right after the kill (separated by ;). - = nothing
ABUSE_AFTER_KILL_COMMANDS=-
# Only after staff approves it (buttons on the Discord alert / web interface).
# entity.deleteby deletes everything the player owns. - = nothing
ABUSE_APPROVAL_COMMANDS=entity.deleteby "{name}"
# When the punished player respawns (within 1 hour)
ABUSE_ON_RESPAWN_COMMANDS=global.sleep "{name}"

# ---------- Alerts & backups ----------
# Ping staff when the server has been offline (no RCON) for this many minutes, and when it is back. 0 = off
SERVER_DOWN_ALERT_MINUTES=10
# Channel for alerts (empty = admin log channel) and roles to ping (empty = admin roles)
ALERT_CHANNEL_ID=
ALERT_ROLE_IDS=
# Daily backup of database, web logins, rules and knowledge base to data/backups/ (also before every update)
BACKUP_ENABLED=true
BACKUP_KEEP_DAYS=7

# ---------- Web interface ----------
# Runs inside the bot; open in your browser: http://localhost:8080
WEB_ENABLED=true
# 127.0.0.1 = this PC only. 0.0.0.0 = also other devices on your home network (phone/laptop).
# NEVER expose it to the internet via port forwarding on your router (no HTTPS)!
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Reachable from the internet via a free, encrypted Cloudflare tunnel (https://….trycloudflare.com).
# On by default: the bot sets it up by itself and shows the link in its window, in PUBLIC_LINK.txt,
# on the Overview and in the admin log channel. Without a WEB_PASSWORD one is generated and saved here.
WEB_TUNNEL=true
# Optional fixed address: token of a tunnel created in the Cloudflare dashboard + its address
WEB_TUNNEL_TOKEN=
WEB_PUBLIC_URL=
# Login password (empty = a random password on every start, shown in the bot window)
WEB_PASSWORD=
# Open the browser automatically on startup
WEB_OPEN_BROWSER=true

# ---------- Automatic updates ----------
# The bot checks GitHub every few minutes and installs a new version by itself, then restarts
# (your .env, data/, logs/ and edited rules/knowledge base are never touched). true/false
AUTO_UPDATE=true
# Minutes between checks
AUTO_UPDATE_INTERVAL=5
# Where updates come from (GitHub owner/repository and branch)
AUTO_UPDATE_REPO=lukas04545/ff
AUTO_UPDATE_BRANCH=main

# ---------- Storage ----------
DATABASE_PATH=data/bot.db
