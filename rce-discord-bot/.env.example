# ===================================================================
#  Rust Console Edition Discord-Bot – Konfiguration
#  Kopiere diese Datei nach ".env" und trage deine Werte ein.
#  Die .env-Datei NIEMALS teilen oder in Git hochladen!
# ===================================================================

# ---------- Discord ----------
# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token)
DISCORD_TOKEN=
# ID deines Discord-Servers (Rechtsklick auf Server -> "Server-ID kopieren").
# Mit Guild-ID erscheinen die Slash-Commands sofort.
GUILD_ID=

# ---------- RCON (G-Portal) ----------
# IP-Adresse des Servers (ohne Port), z. B. 123.45.67.89
RCON_HOST=
# RCON-Port (G-Portal-Panel -> Netzwerk/Ports bzw. Server-Info "RCON-Port")
RCON_PORT=
# RCON-Passwort (G-Portal-Panel -> Einstellungen -> Grundeinstellungen)
# Tipp: nur Buchstaben und Zahlen verwenden (keine / ? # %)
RCON_PASSWORD=

# ---------- Berechtigungen ----------
# Kommagetrennte Rollen-IDs, die Admin-Befehle nutzen dürfen
ADMIN_ROLE_IDS=
# Kommagetrennte User-IDs mit Admin-Rechten (zusätzlich zu den Rollen)
ADMIN_USER_IDS=
# /rcon (beliebige Konsolenbefehle) erlauben? true/false
ALLOW_RAW_RCON=true

# ---------- Channels (leer lassen = Feature aus) ----------
# Hier wird ein Status-Embed gepostet und laufend aktualisiert
STATUS_CHANNEL_ID=
# Chat-Bridge (Quick-Chat ingame <-> Discord)
CHAT_CHANNEL_ID=
# Killfeed
KILLFEED_CHANNEL_ID=
# Joins/Leaves, Server-Events (Heli, Cargo, Airdrop ...), Teams
EVENTS_CHANNEL_ID=
# Bans, Rollenänderungen, Kits/Items, Bot-Admin-Aktionen, Verbindungsstatus
ADMIN_LOG_CHANNEL_ID=
# Komplette Server-Konsole (sehr viele Nachrichten – eigener privater Channel!)
CONSOLE_LOG_CHANNEL_ID=

# ---------- Verhalten ----------
# Status-Embed/Bot-Aktivität aktualisieren alle X Sekunden (min. 30)
STATUS_INTERVAL=60
# Spielerliste abfragen alle X Sekunden (min. 10) – bestimmt Join/Leave-Verzögerung
PLAYERLIST_INTERVAL=30
# Discord-Nachrichten im Chat-Channel ins Spiel senden (braucht Message Content Intent)
CHAT_BRIDGE_TO_GAME=true
# [CHAT SERVER]-Zeilen (z. B. "say") auch in Discord anzeigen (Achtung: Echo der Bridge)
CHAT_SHOW_SERVER_MESSAGES=false
# Respawns ("has entered the game") im Events-Channel anzeigen
SHOW_RESPAWNS=false
# Präfix für Discord-Nachrichten im Spiel (Rust Rich-Text erlaubt)
SAY_PREFIX=<color=#5865F2>[Discord]</color>
# Optionaler Anzeigename für das Status-Embed (sonst Hostname vom Server)
SERVER_DISPLAY_NAME=

# ---------- Befehls-Vorlagen (ANNAHME, siehe README) ----------
# {name} wird durch den Spielernamen ersetzt.
KICK_COMMAND_TEMPLATE=kick "{name}"
BAN_COMMAND_TEMPLATE=banid "{name}"
UNBAN_COMMAND_TEMPLATE=unbanid "{name}"

# ---------- Kitmanager ----------
# Befehls-Vorlagen (ANNAHME, siehe README). Platzhalter: {kit} {name} {group}
# {item} {amount} {condition} {container} {id}
KIT_GIVE_TEMPLATE=kit givetoplayer "{kit}" "{name}"
KIT_GIVE_GROUP_TEMPLATE=kit givetogroup "{kit}" "{group}"
KIT_GIVE_ALL_TEMPLATE=kit giveall "{kit}"
KIT_ADD_TEMPLATE=kit add "{kit}" "{item}" "{amount}" "{condition}" "{container}"
KIT_REMOVE_TEMPLATE=kit remove "{kit}" "{id}"
# Item-Vergabe für Custom Kits (ANNAHME, Syntax wie Rust PC). Platzhalter: {name} {item} {amount}
ITEM_GIVE_TEMPLATE=inventory.giveto "{name}" "{item}" {amount}
# Sekunden Wartezeit zwischen Respawn und Autokit-Vergabe
AUTOKIT_DELAY=3
# Bei Quick-Chat-Autokits ingame per "say" melden: erhalten / Cooldown / Limit
KIT_CLAIM_ANNOUNCE=true

# ---------- Support-Tickets mit KI (DeepSeek-Plattform) ----------
# Kategorie, in der Ticket-Channels angelegt werden (leer = Tickets aus)
TICKET_CATEGORY_ID=
# Channel für Ticket-Protokolle und Transkripte (privat!)
TICKET_LOG_CHANNEL_ID=
# Rollen, die Tickets sehen und gepingt werden (leer = ADMIN_ROLE_IDS)
SUPPORT_ROLE_IDS=
# API-Key von https://platform.deepseek.com/api_keys (leer = Tickets ohne KI, direkt an Staff)
# Verbrauch & Guthaben: https://platform.deepseek.com/usage
DEEPSEEK_API_KEY=
# Modell (deepseek-chat wurde im Juli 2026 abgeschaltet; aktuelle Namen siehe api-docs.deepseek.com)
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Wissensbasis, aus der die KI antwortet (Änderungen gelten sofort)
SUPPORT_KNOWLEDGE_FILE=support_knowledge.md
# Max. KI-Antworten pro Ticket, danach wird Staff gerufen
TICKET_AI_MAX_REPLIES=20

# ---------- Community (Willkommen, Auto-Rolle, Discord-Log, Regeln, Giveaways) ----------
# Hinweis: Willkommen/Auto-Rolle/Join-Leave-Log brauchen im Developer Portal den
# "Server Members Intent", der Nachrichten-Log den "Message Content Intent".
# Channel für Willkommensnachrichten (leer = aus)
WELCOME_CHANNEL_ID=
# Platzhalter: {member} = Erwähnung, {server} = Servername, {count} = Mitgliederzahl,
# {rules} = " in #regel-channel" (wenn RULES_CHANNEL_ID gesetzt)
WELCOME_MESSAGE=Willkommen {member} auf **{server}**! Lies dir die Regeln durch{rules} – viel Spaß!
# Rolle, die neue Mitglieder automatisch bekommen (Bot-Rolle muss darüber stehen)
AUTO_ROLE_ID=
# Discord-Log: Beitritte/Austritte, gelöschte/bearbeitete Nachrichten, /mod-Aktionen, Giveaways
DISCORD_LOG_CHANNEL_ID=
# Regel-Channel (wird in /rust und in der Willkommensnachricht verlinkt)
RULES_CHANNEL_ID=
# Datei mit den Regeln für /regeln (eine Regel pro Zeile)
RULES_FILE=rules.md
# Angaben für /rust
RUST_SERVER_PLATFORM=Rust Console Edition (Xbox & PlayStation)
RUST_SERVER_WIPE=Siehe Ankündigungen im Discord
# Rolle für Giveaway-Gewinner (leer = keine)
GIVEAWAY_WINNER_ROLE_ID=

# ---------- Webinterface ----------
# Läuft im Bot mit; im Browser öffnen: http://localhost:8080
WEB_ENABLED=true
# 127.0.0.1 = nur dieser PC. 0.0.0.0 = auch andere Geräte im Heimnetz (Handy/Laptop).
# NIEMALS per Portfreigabe im Router ins Internet stellen (kein HTTPS)!
WEB_HOST=127.0.0.1
WEB_PORT=8080
# Login-Passwort (leer = bei jedem Start ein zufälliges Passwort, steht dann im Bot-Fenster)
WEB_PASSWORD=
# Browser beim Start automatisch öffnen
WEB_OPEN_BROWSER=true

# ---------- Speicher ----------
DATABASE_PATH=data/bot.db
